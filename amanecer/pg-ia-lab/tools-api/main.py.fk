"""
pg-ai-tools: Servidor de herramientas para Open WebUI
Expone el esquema de PostgreSQL y ejecución de SQL como endpoints REST.
"""

import os
import json
import logging
from typing import Any
from contextlib import asynccontextmanager

import asyncpg
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

DATABASE_URL = os.getenv(
    "DATABASE_URL",
    "postgresql://postgres:postgres@postgres:5432/postgres"
)

pool: asyncpg.Pool = None


@asynccontextmanager
async def lifespan(app: FastAPI):
    global pool
    logger.info(f"Conectando a Postgres: {DATABASE_URL}")
    pool = await asyncpg.create_pool(DATABASE_URL, min_size=2, max_size=10)
    logger.info("Pool de conexiones listo")
    yield
    await pool.close()
    logger.info("Pool cerrado")


app = FastAPI(
    title="pg-ai-tools",
    description="Herramientas de consulta PostgreSQL para Open WebUI + Ollama",
    version="1.0.0",
    lifespan=lifespan,
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)


class SQLRequest(BaseModel):
    query: str
    limit: int = 500


class TableRequest(BaseModel):
    schema_name: str = "public"
    table_name: str


# ── Endpoints ──────────────────────────────────────────────────────────────────

@app.get("/health")
async def health():
    return {"status": "ok"}


@app.get("/schema")
async def get_schema(schema_name: str = "public"):
    """
    Devuelve el esquema completo: tablas, columnas, tipos y claves foráneas.
    El LLM usa esto para generar SQL correcto.
    """
    async with pool.acquire() as conn:
        # Tablas y columnas
        columns = await conn.fetch("""
            SELECT
                c.table_name,
                c.column_name,
                c.data_type,
                c.is_nullable,
                c.column_default,
                tc.constraint_type
            FROM information_schema.columns c
            LEFT JOIN information_schema.key_column_usage kcu
                ON c.table_name = kcu.table_name
                AND c.column_name = kcu.column_name
                AND c.table_schema = kcu.table_schema
            LEFT JOIN information_schema.table_constraints tc
                ON kcu.constraint_name = tc.constraint_name
                AND kcu.table_schema = tc.table_schema
            WHERE c.table_schema = $1
            ORDER BY c.table_name, c.ordinal_position
        """, schema_name)

        # Claves foráneas
        fks = await conn.fetch("""
            SELECT
                kcu.table_name,
                kcu.column_name,
                ccu.table_name AS foreign_table,
                ccu.column_name AS foreign_column
            FROM information_schema.table_constraints AS tc
            JOIN information_schema.key_column_usage AS kcu
                ON tc.constraint_name = kcu.constraint_name
            JOIN information_schema.constraint_column_usage AS ccu
                ON ccu.constraint_name = tc.constraint_name
            WHERE tc.constraint_type = 'FOREIGN KEY'
              AND tc.table_schema = $1
        """, schema_name)

        # Row counts por tabla
        tables = list({r["table_name"] for r in columns})
        row_counts = {}
        counts = await conn.fetch("""
            SELECT relname, reltuples::bigint AS estimate
            FROM pg_class
            WHERE relkind = 'r'
              AND relnamespace = (
                SELECT oid FROM pg_namespace WHERE nspname = $1
              )
        """, schema_name)
        for r in counts:
            row_counts[r["relname"]] = r["estimate"]

    # Construir estructura
    schema: dict[str, Any] = {}
    for row in columns:
        t = row["table_name"]
        if t not in schema:
            schema[t] = {
                "columns": [],
                "row_count": row_counts.get(t),
                "foreign_keys": []
            }
        schema[t]["columns"].append({
            "name": row["column_name"],
            "type": row["data_type"],
            "nullable": row["is_nullable"] == "YES",
            "default": row["column_default"],
            "constraint": row["constraint_type"],
        })

    for fk in fks:
        t = fk["table_name"]
        if t in schema:
            schema[t]["foreign_keys"].append({
                "column": fk["column_name"],
                "references": f"{fk['foreign_table']}.{fk['foreign_column']}"
            })

    return {"schema_name": schema_name, "tables": schema}


@app.get("/schemas")
async def list_schemas():
    """Lista los schemas útiles disponibles en la base de datos."""
    async with pool.acquire() as conn:
        rows = await conn.fetch("""
            SELECT schema_name
            FROM information_schema.schemata
            WHERE schema_name NOT IN ('pg_catalog', 'information_schema', 'pg_toast')
              AND schema_name NOT LIKE 'pg_temp_%'
              AND schema_name NOT LIKE 'pg_toast_temp_%'
            ORDER BY schema_name
        """)
    return {"schemas": [r["schema_name"] for r in rows]}

@app.post("/query")
async def run_query(req: SQLRequest):
    """
    Ejecuta una consulta SQL de solo lectura (SELECT).
    Devuelve filas como lista de objetos JSON.
    """
    sql = req.query.strip()

    # Seguridad básica: solo SELECT
    first_word = sql.upper().split()[0] if sql else ""
    if first_word not in ("SELECT", "WITH", "EXPLAIN"):
        raise HTTPException(
            status_code=400,
            detail="Solo se permiten consultas SELECT, WITH o EXPLAIN."
        )

    # Añadir LIMIT si no lo tiene
    if "LIMIT" not in sql.upper() and first_word == "SELECT":
        sql = f"{sql} LIMIT {req.limit}"

    async with pool.acquire() as conn:
        try:
            rows = await conn.fetch(sql)
        except asyncpg.PostgresError as e:
            raise HTTPException(status_code=400, detail=str(e))

    columns = list(rows[0].keys()) if rows else []
    data = [dict(r) for r in rows]

    # Serializar tipos especiales
    def serialize(v):
        if hasattr(v, "isoformat"):
            return v.isoformat()
        return v

    data = [{k: serialize(v) for k, v in row.items()} for row in data]

    return {
        "columns": columns,
        "rows": data,
        "count": len(data),
        "sql": sql,
    }


@app.get("/sample/{table_name}")
async def sample_table(table_name: str, schema_name: str = "public", limit: int = 10):
    """Devuelve una muestra de filas de una tabla."""
    req = SQLRequest(
        query=f'SELECT * FROM "{schema_name}"."{table_name}" LIMIT {limit}',
        limit=limit
    )
    return await run_query(req)


@app.get("/stats/{table_name}")
async def table_stats(table_name: str, schema_name: str = "public"):
    """Estadísticas básicas (min, max, avg, nulls) para columnas numéricas."""
    async with pool.acquire() as conn:
        cols = await conn.fetch("""
            SELECT column_name, data_type
            FROM information_schema.columns
            WHERE table_schema = $1 AND table_name = $2
              AND data_type IN (
                'integer','bigint','numeric','real','double precision',
                'smallint','decimal','money'
              )
        """, schema_name, table_name)

        if not cols:
            return {"message": "No hay columnas numéricas en esta tabla."}

        stats = {}
        for col in cols:
            cn = col["column_name"]
            row = await conn.fetchrow(f"""
                SELECT
                    MIN("{cn}") as min,
                    MAX("{cn}") as max,
                    AVG("{cn}") as avg,
                    COUNT(*) FILTER (WHERE "{cn}" IS NULL) as nulls,
                    COUNT(*) as total
                FROM "{schema_name}"."{table_name}"
            """)
            stats[cn] = dict(row)

    return {"table": table_name, "numeric_stats": stats}
